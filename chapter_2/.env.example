# Copy this file to .env (in this folder) and fill in your own values.
# Keep exactly ONE of the blocks below uncommented.

# --- OpenAI (the book's default) ---
# OPENAI_API_KEY='your-openai-api-key'
# OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini free tier (key from https://aistudio.google.com/apikey) ---
# Free tier allows only ~20 requests/day per model; if you get error 429,
# switch OPENAI_MODEL to another one, e.g. gemini-flash-lite-latest.
# OPENAI_API_KEY='your-gemini-api-key'
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-3.5-flash-lite

# --- LM Studio, local model (no key needed; start the server on port 1234 first) ---
OPENAI_API_KEY=lm-studio
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_MODEL=llama-3.2-3b-instruct
